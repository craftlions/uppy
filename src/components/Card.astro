---
import Label from "./Label.astro";

/**
 * Bordered editorial card. Optional monospace kicker label at the top,
 * a heading, then free body content via the default slot.
 * `alert` switches the kicker to amber for safety beats.
 */
interface Props {
	kicker?: string;
	title: string;
	tone?: "default" | "alert";
	class?: string;
}

const { kicker, title, tone = "default", class: className = "" } = Astro.props;
---

<article
	class:list={[
		"grid content-start gap-4 border border-neutral-950 p-6 sm:p-8",
		tone === "alert" ? "bg-amber-50" : "",
		className,
	]}
>
	{kicker && <Label tone={tone}>{kicker}</Label>}
	<h3 class="text-xl font-bold tracking-tight sm:text-2xl">{title}</h3>
	<div class="text-base leading-relaxed text-neutral-700">
		<slot />
	</div>
</article>
