---
/**
 * Editorial link-button. Two looks:
 *   solid — filled ink block (primary CTA)
 *   ghost — hairline-outlined (secondary)
 * Always renders an <a>; this is a content site with no client JS.
 */
interface Props {
	href: string;
	variant?: "solid" | "ghost";
	class?: string;
}

const { href, variant = "solid", class: className = "" } = Astro.props;

const base =
	"inline-flex items-center gap-2 px-5 py-3 font-mono text-sm font-medium uppercase tracking-wider no-underline transition-colors";
const looks = {
	solid: "bg-neutral-950 text-white hover:bg-amber-500 hover:text-neutral-950",
	ghost:
		"border border-neutral-950 text-neutral-950 hover:bg-neutral-950 hover:text-white",
};
---

<!-- biome-ignore lint/a11y/useAnchorContent: anchor text is always provided by the caller via <slot /> -->
<a href={href} class:list={[base, looks[variant], className]}>
	<slot />
</a>
