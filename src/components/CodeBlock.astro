---
/**
 * Framed terminal/file block: a dark title bar with a monospace label
 * (and optional right-aligned meta), then a scrollable code body in the slot.
 */
interface Props {
	title: string;
	meta?: string;
	class?: string;
}

const { title, meta, class: className = "" } = Astro.props;
---

<div class:list={["border border-neutral-950", className]}>
	<div
		class="flex items-center justify-between border-b border-neutral-950 bg-neutral-950 px-4 py-2"
	>
		<span class="font-mono text-xs uppercase tracking-widest text-white"
			>{title}</span
		>
		{meta && <span class="font-mono text-xs text-white/60">{meta}</span>}
	</div>
	<div
		class="overflow-x-auto p-4 font-mono text-xs leading-7 sm:text-sm sm:leading-8"
	>
		<slot />
	</div>
</div>
