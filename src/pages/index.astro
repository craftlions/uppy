---
import ClosingCta from "../components/ClosingCta.astro";
import FastFreeSection from "../components/FastFreeSection.astro";
import HeroSection from "../components/HeroSection.astro";
import ManagersSection from "../components/ManagersSection.astro";
import ProblemSection from "../components/ProblemSection.astro";
import RenovateSection from "../components/RenovateSection.astro";
import SafetySection from "../components/SafetySection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout>
	<SiteHeader />
	<main class="mx-auto max-w-6xl px-6">
		<HeroSection />
		<ProblemSection />
		<SafetySection />
		<RenovateSection />
		<ManagersSection />
		<FastFreeSection />
		<ClosingCta />
	</main>
	<SiteFooter />
</Layout>
