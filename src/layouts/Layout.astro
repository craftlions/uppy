---
import "../styles/global.css";

/**
 * Document shell for the marketing site: head, social meta, canonical.
 * Page content goes in the default slot.
 */
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "uppy — paranoid dependency updates",
	description = "A Renovate-compatible dependency update bot that waits until a release has aged into safety before it opens the PR.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonical} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a0a0a" />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
	</head>
	<body
		class="min-h-dvh bg-white text-neutral-950 antialiased selection:bg-amber-500 selection:text-white"
	>
		<slot />
	</body>
</html>
